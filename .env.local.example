# ── AstroDaddy Webapp – Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Add all variables to Vercel via: vercel env add <NAME>

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://astrodaddy.de          # Production URL (no trailing slash)

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...          # Public (safe to expose in frontend)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # Secret – only used in API routes, never frontend!

# ── Mollie ────────────────────────────────────────────────────────────────────
# Get from: https://my.mollie.com → Developers → API keys
# Use test key (test_...) during development, live key (live_...) for production
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Lexware / Lexoffice ───────────────────────────────────────────────────────
# Get from: https://app.lexoffice.de → Einstellungen → Schnittstellen → API
API_Lexware=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── IONOS SMTP (E-Mail) ───────────────────────────────────────────────────────
# IONOS Mailbox-Zugangsdaten: IONOS → E-Mail → Mailbox verwalten → SMTP
# Port 587 = STARTTLS (empfohlen), Port 465 = SSL/TLS
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=noreply@astrodaddy.de        # IONOS Postfach-Adresse
SMTP_PASS=xxxxxxxxxxxxxxxxxxxx         # IONOS Postfach-Passwort
SMTP_FROM=AstroDaddy <noreply@astrodaddy.de>

# ── Skool (Astroversity Academy Mitgliedschaft) ───────────────────────────────
# Skool → Gruppe → Settings → Plugins → Webhook
# Webhook-URL (ohne ?email=… – das hängt der Code automatisch an)
SKOOL_WEBHOOK_URL=https://api2.skool.com/groups/astroversity-academy/webhooks/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# X-Api-Secret aus demselben Webhook-Dialog (geheim halten, nicht teilen!)
SKOOL_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Beliebiger geheimer String – wird im Header x-admin-secret mitgeschickt
ADMIN_SECRET=change-me-to-something-random
